# Copy to .env.solana (gitignored) in this same folder and fill in. Never paste these into chat.
# On Vercel, set the same names in the project's Environment Variables instead.

# Public — from dashboard.privy.io → your app → App ID
NEXT_PUBLIC_PRIVY_APP_ID=

# Secret — same page, App Secret (server only)
PRIVY_APP_SECRET=

# Secret — from dashboard.helius.dev → API Keys (server only; the browser never sees it)
HELIUS_API_KEY=

# Secret, deploy only — the JSON byte array from solana/.keys/fee-payer.json.
# Leave empty locally: in development the app reads that file directly.
FOLIO_FEE_PAYER_SECRET=
