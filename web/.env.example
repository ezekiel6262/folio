# Optional. A CDP Paymaster URL (CDP dashboard > Onchain Tools > Paymaster).
# When set, gas is sponsored for smart-wallet users so they never need ETH.
# Server-only: it is a spending authority and must never reach the browser.
# Also set a contract allowlist in the CDP dashboard as a second layer.
PAYMASTER_URL=

# Optional. A free project id from reown.com. Without it the WalletConnect
# option is hidden rather than shown as a button that cannot work.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional. A private RPC avoids the public Base endpoint's rate limits.
BASE_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org

# Set automatically by scripts/sync-assets.mjs after deploying the vault.
# Override here only to point a preview at a different vault.
NEXT_PUBLIC_VAULT_ADDRESS=
NEXT_PUBLIC_VAULT_DEPLOY_BLOCK=
